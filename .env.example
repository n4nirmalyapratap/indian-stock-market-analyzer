# ── Nifty Node — Environment Variables ───────────────────────────────────────
# Copy this to .env and fill in your values for local development.
# On Replit, use the Secrets tab (padlock icon) instead — .env is ignored there.
#
# Priority order (highest wins):
#   1. Replit Secrets / shell environment
#   2. .env file (loaded automatically on backend startup via python-dotenv)
#   3. Admin Dashboard → Secrets page (hot-reload, no restart needed)
# ─────────────────────────────────────────────────────────────────────────────


# ── Auth — JWT Secret (REQUIRED) ─────────────────────────────────────────────
# Signs every login token. Must be long, random, and private.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"

SESSION_SECRET=replace_with_a_long_random_secret_here


# ── Admin Dashboard Credentials (REQUIRED) ───────────────────────────────────
# Username + password for the /admin panel. Set something strong before deploying.

POSTGRES_DB=niftynode
POSTGRES_USER=niftynode
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
DATABASE_URL=postgresql://niftynode:replace_with_a_strong_postgres_password@postgres:5432/niftynode

GOOGLE_CLIENT_ID=your_google_web_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id_here
ADMIN_GOOGLE_EMAILS=you@example.com


# ── FRED API Key — Macro Pulse data (RECOMMENDED) ────────────────────────────
# Free at https://fred.stlouisfed.org/docs/api/api_key.html (2-minute sign-up).
# Unlocks: RBI Repo Rate, India CPI, IIP, and India 10Y Yield tiles in the
# Macro Pulse strip and Insights → Macro tab.
# Without this key the app falls back to World Bank annual data for CPI/IIP/GDP,
# but Repo Rate and 10Y Yield will show "—".
# Can also be set via Admin Dashboard → Secrets (no restart needed).

FRED_API_KEY=your_fred_api_key_here


# ── OpenRouter API Key — AI Analyst & Macro commentary (RECOMMENDED) ─────────
# Free tier available at https://openrouter.ai
# Powers: AI Stock Analyst deep reports, Compare mode, Scan, and the
# "What changed this week" Macro commentary on the Insights page.
# Can also be set via Admin Dashboard → Secrets (no restart needed).

AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ── AI Model Selection (optional — defaults shown) ───────────────────────────
# Any model slug available on your OpenRouter account works here.

# AI_MODEL=google/gemma-4-31b-it:free
# AI_FALLBACK_MODEL=qwen/qwen3-235b-a22b:free

# Daily quota for deep AI Analyst reports per user (cached reports don't count):
# AI_ANALYST_DAILY_QUOTA=3


# ── Feature Flags (optional) ─────────────────────────────────────────────────
# AI Analyst feature gate (also toggled by the workflow launch command):
# FEATURE_AI_ANALYST=on

# Timeout in seconds for a single AI Analyst call:
# AI_ANALYST_TIMEOUT_SEC=240


# ── FRED API Key — Macro Pulse data (RECOMMENDED) ────────────────────────────
# Free at https://fred.stlouisfed.org/docs/api/api_key.html (2-minute sign-up).
# Unlocks: RBI Repo Rate, India CPI, IIP, and India 10Y Yield tiles in the
# Macro Pulse strip and Insights → Macro tab.
# Without this key the app falls back to World Bank annual data for CPI/IIP/GDP,
# but Repo Rate and 10Y Yield will show "—".
# Can also be set via Admin Dashboard → Secrets (no restart needed).

FRED_API_KEY=your_fred_api_key_here


# ── OpenRouter API Key — AI Analyst & Macro commentary (RECOMMENDED) ─────────
# Free tier available at https://openrouter.ai
# Powers: AI Stock Analyst deep reports, Compare mode, Scan, and the
# "What changed this week" Macro commentary on the Insights page.
# Can also be set via Admin Dashboard → Secrets (no restart needed).

AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ── AI Model Selection (optional — defaults shown) ───────────────────────────
# Any model slug available on your OpenRouter account works here.

# AI_MODEL=google/gemma-4-31b-it:free
# AI_FALLBACK_MODEL=qwen/qwen3-235b-a22b:free

# Daily quota for deep AI Analyst reports per user (cached reports don't count):
# AI_ANALYST_DAILY_QUOTA=3


# ── Feature Flags (optional) ─────────────────────────────────────────────────
# AI Analyst feature gate (also toggled by the workflow launch command):
# FEATURE_AI_ANALYST=on

# Timeout in seconds for a single AI Analyst call:
# AI_ANALYST_TIMEOUT_SEC=240


# ── Clerk Authentication (optional — enables Google OAuth) ───────────────────
# If set, shows "Continue with Google" alongside the email+password login form.
# Get all three values from https://dashboard.clerk.com → Your App → API Keys.
# All three must come from the same Clerk application.

# ── Telegram Bot (optional) ───────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, paste the token here.
# Can also be set via Admin Dashboard → Secrets.

# TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── WhatsApp / Twilio (optional) ──────────────────────────────────────────────
# Requires a Twilio account with a WhatsApp sandbox or approved sender number.

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# WHATSAPP_ENABLED=true


# ── OpenAI (optional — AI fallback if OpenRouter is unavailable) ─────────────
# Only used when OpenRouter returns an error. Can also be set via Admin → Secrets.

# AI_INTEGRATIONS_OPENAI_API_KEY=sk-your_openai_key_here
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1


# ── Tavily News Search (optional — improves AI Analyst news coverage) ─────────
# When the RSS feed returns fewer than 3 articles for a ticker, the AI Analyst
# tops up the news block via Tavily. Mid-cap and small-cap coverage gets a big
# lift from this; large-caps barely notice. Get a key at https://tavily.com
# (free tier is generous). If unset, the AI Analyst silently sticks to RSS only.

# TAVILY_API_KEY=tvly-your_tavily_key_here


# ── Email Digest (optional — daily portfolio mail) ────────────────────────────
# Sends a daily portfolio summary at a per-user IST time. Architecture: the
# backend enqueues a row in email_digest_queue when a subscription is due,
# and a worker drains the queue at a controlled rate (default 20/min, 400/day)
# so a burst of subscribers doesn't blow Gmail's 500/day free-tier cap.
#
# For Gmail: enable 2FA, then generate an App Password at
#   https://myaccount.google.com/apppasswords  (NOT your main account password).
# The backend's email_digest service becomes a no-op until all three of
# SMTP_HOST / SMTP_USERNAME / SMTP_PASSWORD are set.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=you@gmail.com
# SMTP_FROM_NAME=Indian Stock Market Analyzer

# Rate-limit knobs — defaults stay under Gmail's free-tier cap of 500/day.
# EMAIL_DIGEST_SENDS_PER_MIN=20
# EMAIL_DIGEST_SENDS_PER_DAY=400


# ── Anti-FOMO Bias Check (defaults shown — usually fine) ─────────────────────
# Programmatic guard against chasing extended stocks. If the AI Analyst issues
# a BUY but the stock is trading more than BIAS_THRESHOLD% above its 20-day MA,
# the verdict is downgraded to HOLD with a "wait for pullback" warning. Strong
# trend stacks (MA5>MA10>MA20) get a relaxed threshold via BIAS_RELAX_MULTIPLIER
# so legitimate momentum setups aren't suppressed. Set BIAS_CHECK_ENABLED=false
# to disable entirely.

# BIAS_CHECK_ENABLED=true
# BIAS_THRESHOLD=5.0
# BIAS_RELAX_MULTIPLIER=1.6
